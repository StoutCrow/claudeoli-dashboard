{
  "name": "claudeoli-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "An Obsidian dashboard for a fleet of Claude Code sessions, from vault notes and a Matrix agent bus.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "test": "node --test \"test/**/*.test.ts\"",
    "lint": "eslint src",
    "harness": "node dev/build-harness.mjs --serve",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "author": "Oli_G",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@eslint/json": "^0.14.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "lucide": "^0.344.0",
    "obsidian": "^1.14.4",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
